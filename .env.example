# Shared secret used to HMAC-sign session tokens (see netlify/functions/_session.js).
SESSION_SECRET=""

# Google OAuth confidential client secret (client ID is public, hardcoded in google-callback.js).
GOOGLE_CLIENT_SECRET=""

# The one Google account treated as "owner" (write access to Studies/Topics/Insights).
OWNER_GOOGLE_EMAIL=""

# Required for the app-manager dashboard to read GET /api/admin/stats. Generate any random
# string, set the same value as ANCHOR_ADMIN_SECRET in app-manager's .env.
ADMIN_SYNC_SECRET=""
